    "./channel-echo": "./src/channel-echo/index.mjs",
    "./sheaf-crdt": "./src/sheaf-crdt/index.mjs",
    "./capsule": "./src/capsule/index.mjs",
    "./actuation": "./src/actuation/index.mjs",
    "./translators": "./src/translators/index.mjs",
    "./composites": "./src/composites/index.mjs",
    "./judgment": "./src/judgment/index.mjs",
    "./multitrack": "./src/multitrack/index.mjs",
    "./coarchitect": "./src/coarchitect/index.mjs",
    "./skills": "./src/skills/compiler.mjs",
